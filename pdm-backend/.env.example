# Backend Configuration for PDM Loan Management System
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit the .env file to version control

# ============================================================================
# Database Configuration
# ============================================================================

# MySQL Database Connection
# Format: jdbc:mysql://[host]:[port]/[database_name]?[parameters]
DB_URL=jdbc:mysql://localhost:3306/olavs_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password_here

# ============================================================================
# JWT Authentication Configuration
# ============================================================================

# JWT Secret Key
# CRITICAL: Generate a strong, random secret key (minimum 256 bits)
# Generate with: openssl rand -base64 64
# This key is used to sign JWT tokens - changing it will invalidate all existing tokens
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-use-openssl-rand-base64-64

# JWT Token Expiration (in milliseconds)
# Default: 900000 (15 minutes)
JWT_EXPIRATION=900000

# JWT Refresh Token Expiration (in milliseconds)
# Default: 604800000 (7 days)
JWT_REFRESH_EXPIRATION=604800000

# JWT Cookie Configuration
JWT_COOKIE_NAME=token
JWT_COOKIE_MAX_AGE=900

# ============================================================================
# Server Configuration (Optional)
# ============================================================================

# Application Port
# Default: 8080
# SERVER_PORT=8080

# Active Spring Profile
# Options: dev, prod, test
# Default: dev
# SPRING_PROFILES_ACTIVE=dev

# ============================================================================
# CORS Configuration (Optional)
# ============================================================================

# Allowed Origins for CORS
# Default: http://localhost:3000,http://localhost:5173
# For multiple origins, use comma-separated values
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allowed HTTP Methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed Headers
CORS_ALLOWED_HEADERS=*

# Allow Credentials (needed for HttpOnly cookies)
CORS_ALLOW_CREDENTIALS=true

# Max Age (preflight cache duration in seconds)
CORS_MAX_AGE=3600

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Application Log Level
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# Security Log Level
SECURITY_LOG_LEVEL=DEBUG

# SQL Log Level
SQL_LOG_LEVEL=DEBUG

# Show SQL Statements
SHOW_SQL=false

# ============================================================================
# Security Guidelines
# ============================================================================
#
# 1. Generate Strong Secrets:
#    - JWT_SECRET: openssl rand -base64 64
#    - DB_PASSWORD: openssl rand -base64 32
#
# 2. Database Security:
#    - Use a dedicated database user (not root in production)
#    - Grant only required permissions
#    - Use strong, unique passwords
#
# 3. Production Considerations:
#    - Enable SSL for database connections
#    - Use environment-specific secrets
#    - Rotate secrets regularly
#    - Use secrets management service (AWS Secrets Manager, HashiCorp Vault)
#
# 4. Never:
#    - Commit this file with real credentials to version control
#    - Use default/example secrets in production
#    - Share secrets via insecure channels
#    - Log secrets or include them in error messages
#
# For more information, see: ../docs/SECRET_MANAGEMENT.md
# ============================================================================
